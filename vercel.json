{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "services/api/app/web/**"
    }
  },
  "crons": [
    {
      "path": "/internal/cleanup-images",
      "schedule": "0 18 * * *"
    }
  ],
  "buildCommand": "EXPO_PUBLIC_API_BASE_URL=/ npm --workspace apps/mobile run export:web:vercel",
  "routes": [
    {
      "src": "/(beta/?)?",
      "dest": "api/index.py"
    },
    {
      "src": "/(app(/.*)?|index.html|auth/callback/?)",
      "dest": "api/index.py"
    },
    {
      "src": "/recruitment/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(privacy|terms|support|account-deletion)/?",
      "dest": "api/index.py"
    },
    {
      "src": "/v1/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/image-uploads/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/ready",
      "dest": "api/index.py"
    },
    {
      "src": "/internal/cleanup-images",
      "dest": "api/index.py"
    },
    {
      "src": "/internal/account-deletions/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/internal/admin/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/docs",
      "dest": "api/index.py"
    },
    {
      "src": "/redoc",
      "dest": "api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
