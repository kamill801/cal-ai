# Web/iOS simulator default can use localhost.
# Android emulator usually needs http://10.0.2.2:8015.
# Android device beta builds need an HTTPS API URL reachable from the device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8015
EXPO_PUBLIC_AUTH_PROVIDER=disabled
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
