{
  "name": "@cal-ai/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web:vercel": "expo export --platform web --output-dir dist-web-preview && rm -rf ../../public && mkdir -p ../../public && cp -R dist-web-preview/. ../../public/",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/run-smoke-tests.mjs",
    "check:store": "node scripts/check-store-build.mjs --check",
    "test:store": "node --test scripts/check-store-build.test.mjs scripts/brand-icons.test.cjs",
    "eas-build-pre-install": "node scripts/check-store-build.mjs"
  },
  "dependencies": {
    "@cal-ai/shared": "0.1.0",
    "@expo/metro-runtime": "6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "54.0.38",
    "expo-auth-session": "7.0.11",
    "expo-image-manipulator": "14.0.8",
    "expo-image-picker": "17.0.11",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "expo-web-browser": "15.0.11",
    "lucide-react-native": "^1.25.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "typescript": "5.9.2"
  }
}
