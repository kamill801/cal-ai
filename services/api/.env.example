BODY_AI_PROVIDER=mock
BODY_AI_CONSENT_POLICY_VERSION=2026-07-23
AI_PROVIDER_API_KEY=
AI_MODEL_VISION=gpt-5.4-mini
AI_MODEL_TEXT=
AUTH_PROVIDER=disabled
SUPABASE_URL=
