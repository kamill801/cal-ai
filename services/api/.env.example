APP_ENV=local
CAL_AI_API_DATA_PATH=.local/cal-ai-api.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cal_ai
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:4173,http://localhost:3016,http://127.0.0.1:3016,http://localhost:3017,http://127.0.0.1:3017
OBJECT_STORAGE_BUCKET=cal-ai-local
STORAGE_PROVIDER=local
R2_BUCKET_NAME=cal-ai-meal-images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
IMAGE_UPLOAD_MAX_BYTES=8000000
IMAGE_TTL_DAYS=30
UPLOAD_SOFT_LIMIT_BYTES=8000000000
CRON_SECRET=
AI_PROVIDER=mock
BODY_AI_PROVIDER=mock
BODY_AI_CONSENT_POLICY_VERSION=2026-07-23
AI_PROVIDER_API_KEY=
AI_MODEL_VISION=gpt-5.4-mini
AI_MODEL_TEXT=
AUTH_PROVIDER=disabled
SUPABASE_URL=
SUPABASE_JWT_ALGORITHM=ES256
# Full self-account deletion. Enable only after the same Supabase project's
# server-only credential and the deletion lifecycle have been verified.
# Future uploads can use signed If-None-Match create-once semantics. Before enabling,
# verify R2 CORS allows If-None-Match and NO bucket lifecycle deletes sealed-v1 guards.
# Content-free zero-byte erasure guards must remain; legacy upload erasure stays pending.
R2_WRITE_ONCE_UPLOADS_ENABLED=false
ACCOUNT_DELETION_ENABLED=false
# Keep false until the authenticated durable worker and storage cleanup are verified.
ACCOUNT_DELETION_WORKER_ENABLED=false
# Existing CRON_SECRET above is server-only; the deletion worker requires 32+ chars.
SUPABASE_SECRET_KEY=
# Optional legacy fallback; never expose either value in an EXPO_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Admin is a separate web app. Keep disabled until the dedicated Supabase account exists.
ADMIN_DASHBOARD_ENABLED=false
ADMIN_FRONTEND_ORIGIN=
ADMIN_SUPABASE_URL=
ADMIN_SUPABASE_JWT_ALGORITHM=ES256
# Comma-separated Supabase user UUIDs. Never use email or a shared password as authorization.
ADMIN_USER_IDS=
# Server-only owner alias mapping. Password is managed in Supabase, never an env var.
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_EMAIL=
ADMIN_SUPABASE_PUBLISHABLE_KEY=
ANALYTICS_TIMEZONE=Asia/Seoul
# Billing tables and UI are ready, but checkout remains unavailable until Groble is approved.
PAYMENT_PROVIDER=disabled
GROBLE_PRODUCT_ID=
GROBLE_WEBHOOK_SECRET=
POSTHOG_KEY=
SENTRY_DSN=
